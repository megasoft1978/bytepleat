+fn check_dictionary(coder: &crate::Coder, max_dictionary_bytes: usize) -> Result<(), Error> {
+    let method = coder.encoder_method_id();
+    let dict = if method == crate::EncoderMethod::ID_LZMA2 {
+        let prop = *coder
+            .properties()
+            .first()
+            .ok_or(Error::other("LZMA2 properties too short"))? as u32;
+        if prop > 40 {
+            return Err(Error::other("invalid LZMA2 dictionary property"));
+        }
+        if prop == 40 {
+            u32::MAX
+        } else {
+            (2 | (prop & 1)) << (prop / 2 + 11)
+        }
+    } else if method == crate::EncoderMethod::ID_LZMA {
+        let props = coder.properties();
+        if props.len() < 5 {
+            return Err(Error::other("LZMA properties too short"));
+        }
+        u32::from_le_bytes([props[1], props[2], props[3], props[4]])
+    } else {
+        0
+    };
+    if dict as u64 > max_dictionary_bytes as u64 {
+        return Err(Error::other("7z dictionary exceeds configured limit"));
+    }
+    Ok(())
 }
 
